{
  "name": "curriculum-api",
  "version": "0.4.0",
  "description": "Hono backend for a personal curriculum site: public chat, recruiter chat and admin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leassis/curriculum-api.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.5.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "curriculum-api": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "README.md",
    "LICENSE",
    "!dist/.claude-repo.tgz"
  ],
  "scripts": {
    "build": "tsdown",
    "verify:tailor": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-tailor.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.client.json",
    "lint": "biome check . && tsx scripts/check-architecture.ts && tsx scripts/build-js.ts --check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "dev": "tsx scripts/build-js.ts && tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local examples/node/server.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/cli.ts seed",
    "db:generate": "drizzle-kit generate",
    "vendor:htmx": "tsx scripts/vendor-htmx.ts",
    "build:css": "tsx scripts/build-css.ts",
    "build:js": "tsx scripts/build-js.ts",
    "build:assets": "pnpm build:css && pnpm build:js",
    "dev:assets": "tsx watch --include \"src/admin/**/client.ts\" scripts/build-js.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.180",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.21",
    "jose": "6.2.18",
    "marked": "16.4.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@hono/node-server": "2.1.11",
    "@tailwindcss/cli": "4.3.5",
    "@testcontainers/postgresql": "12.2.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "htmx.org": "2.0.11",
    "notyf": "3.10.0",
    "tailwindcss": "4.3.5",
    "tsdown": "0.23.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
