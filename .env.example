# Postgres connection string (Neon in production; Neon Local in dev: postgres://neon:npg@localhost:5432/neondb)
DATABASE_URL=
# Direct (non-pooled) Neon connection used only by `migrate`; optional, falls back to DATABASE_URL
DATABASE_URL_UNPOOLED=
# OpenRouter API key used for every LLM call
OPENROUTER_API_KEY=
# Secret for signing session cookies, at least 32 bytes: openssl rand -base64 32
SESSION_SECRET=
# Cloudflare Turnstile secret key for the public chat captcha
TURNSTILE_SECRET=
# bcrypt hash of the admin password: npx curriculum-api hash-password
ADMIN_PASSWORD_HASH=
# Salt for hashing client IPs before they are stored
IP_HASH_SALT=
# AES-256-GCM key for personal info at rest, 32 bytes base64: openssl rand -base64 32 (losing it loses the stored values)
PII_ENCRYPTION_KEY=
# OpenRouter model ID for the public chat
MODEL_PUBLIC=
# OpenRouter model ID for tailored resume generation
MODEL_TAILOR=
# OpenRouter model ID for the recruiter chat
MODEL_RECRUITER=
# Neon API key; read by docker compose from .env and by the integration test setup (which also reads .env.local)
NEON_API_KEY=
# Neon project ID; read by docker compose from .env and by the integration test setup (which also reads .env.local)
NEON_PROJECT_ID=
# Neon branch ID that Neon Local forks the dev branch from (docker compose)
PARENT_BRANCH_ID=
# Neon branch ID the integration tests fork their throwaway branch from; optional, falls back to PARENT_BRANCH_ID
TEST_PARENT_BRANCH_ID=
