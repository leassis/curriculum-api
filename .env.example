# Postgres connection string (Neon in production; the compose Postgres in dev: postgres://postgres:postgres@localhost:5432/curriculum)
DATABASE_URL=
# Direct (non-pooled) Neon connection used only by `migrate`; optional, falls back to DATABASE_URL
DATABASE_URL_UNPOOLED=
# OpenRouter API key used for every LLM call
OPENROUTER_API_KEY=
# Secret for signing session cookies, at least 32 bytes: openssl rand -base64 32
SESSION_SECRET=
# Cloudflare Turnstile secret key for the public chat captcha
TURNSTILE_SECRET=
# bcrypt hash of the admin password: npx curriculum-api hash-password
ADMIN_PASSWORD_HASH=
# Salt for hashing client IPs before they are stored
IP_HASH_SALT=
# AES-256-GCM key for personal info at rest, 32 bytes base64: openssl rand -base64 32 (losing it loses the stored values)
PII_ENCRYPTION_KEY=
# OpenRouter model ID for the public chat
MODEL_PUBLIC=
# OpenRouter model ID for tailored resume generation
MODEL_TAILOR=
# OpenRouter model ID for the recruiter chat
MODEL_RECRUITER=
# OpenRouter model ID for converting pasted text into the career library
MODEL_IMPORT=
# Sampling temperature per area, 0..2; empty uses the default (public 0.4, recruiter 0.3, tailor 0.1, import 0.1)
TEMPERATURE_PUBLIC=
TEMPERATURE_TAILOR=
TEMPERATURE_RECRUITER=
TEMPERATURE_IMPORT=
