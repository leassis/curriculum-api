{
  "name": "Curriculum Admin",
  "description": "Generic admin look for the open-source Curriculum project. Source of truth for theme.css.",
  "font": {
    "sans": { "value": "Inter", "usage": "Body, controls, tables" },
    "display": { "value": "Space Grotesk", "usage": "Page titles, section titles, logo" },
    "mono": { "value": "JetBrains Mono", "usage": "Eyebrows, table headers, URLs, numbers" }
  },
  "color": {
    "page": { "value": "#f7f7f8", "usage": "App background" },
    "surface": { "value": "#ffffff", "usage": "Cards, sidebar" },
    "subtle": { "value": "#f1f1f4", "usage": "Active nav item, ghost hover" },
    "row-hover": { "value": "#fafafa", "usage": "List row hover" },
    "line": { "value": "#e4e4e9", "usage": "Borders, dividers, bar tracks" },
    "ink": { "value": "#18181b", "usage": "Text and headings" },
    "muted": { "value": "#5f5f6b", "usage": "Secondary text" },
    "placeholder": { "value": "#71717a", "usage": "Input placeholders" },
    "primary": { "value": "#4f46e5", "usage": "Primary buttons, active nav bar, focus ring" },
    "primary-hover": { "value": "#4338ca", "usage": "Primary hover, links" },
