    "primary-soft": { "value": "#eef2ff", "usage": "Selected chips, icon tiles" },
    "on-primary": { "value": "#ffffff", "usage": "Text on primary" },
    "success": { "value": "#15803d", "usage": "Match >= 80, Active, strong fit" },
